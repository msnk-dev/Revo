APP_NAME=Revo
APP_ENV=development
APP_CURRENCY=INR
APP_SECRET_KEY=replace-this-local-development-secret
DATABASE_URL=postgresql+psycopg://revo:revo@postgres:5432/revo
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=noreply@revo.local
CORS_ORIGINS=http://localhost:5173

LLM_PROVIDER_ORDER=groq,hf,ollama
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_ROUTER_MODEL=llama-3.1-8b-instant
HF_TOKEN=
HF_MODEL=
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=
OLLAMA_API_KEY=ollama
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=2
LLM_DAILY_TOKEN_BUDGET=100000

